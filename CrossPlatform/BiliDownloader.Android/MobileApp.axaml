<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BiliDownloader.Android.MobileApp"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBg" Color="#00000000"/>
                    <SolidColorBrush x:Key="CardBg" Color="#8C1E1E1E"/>
                    <SolidColorBrush x:Key="CardBgAlt" Color="#7A2A2A2A"/>
                    <SolidColorBrush x:Key="HoverBg" Color="#40FFFFFF"/>
                    <SolidColorBrush x:Key="Border" Color="#4DFFFFFF"/>
                    <SolidColorBrush x:Key="BorderStrong" Color="#73FFFFFF"/>
                    <SolidColorBrush x:Key="WindowScrim" Color="#26000000"/>
                    <SolidColorBrush x:Key="ButtonBg" Color="#7A3D3D3D"/>
                    <SolidColorBrush x:Key="ButtonHoverBg" Color="#8C4A4A4A"/>
                    <SolidColorBrush x:Key="ButtonPressedBg" Color="#70353535"/>
                    <SolidColorBrush x:Key="ComboSelectedBg" Color="#992F4B5F"/>
                    <SolidColorBrush x:Key="TextPrimary" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#C2C2C2"/>
                    <SolidColorBrush x:Key="TextMuted" Color="#9A9A9A"/>
                    <SolidColorBrush x:Key="Accent" Color="#60CDFF"/>
                    <SolidColorBrush x:Key="AccentStrong" Color="#0078D4"/>
                    <SolidColorBrush x:Key="AccentPressed" Color="#0067B8"/>
                    <SolidColorBrush x:Key="Danger" Color="#F14C4C"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBg" Color="#00000000"/>
                    <SolidColorBrush x:Key="CardBg" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="CardBgAlt" Color="#A6F2F2F2"/>
                    <SolidColorBrush x:Key="HoverBg" Color="#1A000000"/>
                    <SolidColorBrush x:Key="Border" Color="#33000000"/>
                    <SolidColorBrush x:Key="BorderStrong" Color="#55000000"/>
                    <SolidColorBrush x:Key="WindowScrim" Color="#26FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBg" Color="#B3F2F2F2"/>
                    <SolidColorBrush x:Key="ButtonHoverBg" Color="#C7E5E5E5"/>
                    <SolidColorBrush x:Key="ButtonPressedBg" Color="#B3DADADA"/>
                    <SolidColorBrush x:Key="ComboSelectedBg" Color="#B3CCE4FF"/>
                    <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#454545"/>
                    <SolidColorBrush x:Key="TextMuted" Color="#6B6B6B"/>
                    <SolidColorBrush x:Key="Accent" Color="#0067B8"/>
                    <SolidColorBrush x:Key="AccentStrong" Color="#0078D4"/>
                    <SolidColorBrush x:Key="AccentPressed" Color="#005A9E"/>
                    <SolidColorBrush x:Key="Danger" Color="#C42B1C"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ==================== 手机端深色配色 ==================== -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- 触屏友好的按钮尺寸 -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource ButtonPressedBg}"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentStrong}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentStrong}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#0A84E0"/>
            <Setter Property="BorderBrush" Value="#0A84E0"/>
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentPressed}"/>
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBgAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBgAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource ComboSelectedBg}"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentStrong}"/>
            <Setter Property="Background" Value="{DynamicResource CardBgAlt}"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <!-- 列表：去掉 Fluent 默认的选中高亮与内边距，保持亚克力卡片观感 -->
        <Style Selector="ListBox.mobile">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.mobile ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ListBox.mobile ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.mobile ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

    </Application.Styles>

</Application>
